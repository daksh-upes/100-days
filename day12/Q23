#include <stdio.h>
int main() {
int days, fine;
printf("Enter number of late days: ");
scanf("%d", &days);
if (days <= 0) {
fine = 0;
printf("No fine\n");
} else if (days <= 5) {
fine = days * 2; // only slab 1
printf("Fine = Rs %d\n", fine);
} else if (days <= 10) {
fine = 5 * 2 + (days - 5) * 4; // slab 1 full + part of slab 2
printf("Fine = Rs %d\n", fine);
} else if (days <= 30) {
fine = 5 * 2 + 5 * 4 + (days - 10) * 6; // slabs 1, 2 full + part of slab 3
printf("Fine = Rs %d\n", fine);
} else {
printf("Membership Cancelled\n");
}
return 0;
}
