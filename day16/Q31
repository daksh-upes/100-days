#include <stdio.h>
int main() {
int n, place = 1;
long long binary = 0;
printf("Enter a decimal number: ");
scanf("%d", &n);
if (n == 0) {
printf("Binary = 0\n");
return 0;
}
while (n > 0) {
int rem = n % 2; binary = binary + rem * place;
place = place * 10; n = n / 2;
// next binary digit (from the right)
// move to next position on the left
}
printf("Binary = %lld\n", binary);
return 0;
}
