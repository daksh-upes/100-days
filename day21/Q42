#include <stdio.h>
int main() {
int n, i, sum = 0;
printf("Enter a number: ");
scanf("%d", &n);
for (i = 1; i <= n / 2; i++) {
if (n % i == 0) {
sum = sum + i; // i is a proper divisor
}
}
if (sum == n && n > 0)
printf("%d is a Perfect number\n", n);
else
printf("%d is not a Perfect number\n", n);
return 0;
}
