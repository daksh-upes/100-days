#include <stdio.h>
int main() {
int n, original, sum = 0, digit, i, fact;
printf("Enter a number: ");
scanf("%d", &n);
original = n;
while (n > 0) {
digit = n % 10;
fact = 1; for (i = 1; i <= digit; i++) {
fact = fact * i;
// factorial of this digit
}
sum = sum + fact;
n = n / 10;
}
if (sum == original)
printf("%d is a Strong number\n", original);
else
printf("%d is not a Strong number\n", original);
return 0;
}
