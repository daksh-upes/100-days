#include <stdio.h>
int main() {
int i, j;
// upper part (rows 1 to 4)
for (i = 1; i <= 4; i++) {
for (j = 1; j <= 4 - i; j++) printf(" "); for (j = 1; j <= 2 * i - 1; j++) printf("*"); printf("\n");
// spaces
// stars
}
// lower part (rows 3 down to 1)
for (i = 3; i >= 1; i--) {
for (j = 1; j <= 4 - i; j++) printf(" ");
for (j = 1; j <= 2 * i - 1; j++) printf("*");
printf("\n");
}
return 0;
}
