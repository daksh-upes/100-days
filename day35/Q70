#include <stdio.h>
int main() {
int arr[100], n, k, i, j, last;
printf("Enter number of elements: ");
scanf("%d", &n);
printf("Enter elements: ");
for (i = 0; i < n; i++) scanf("%d", &arr[i]);
printf("Enter k: ");
scanf("%d", &k);
k = k % n; // rotating n times gives the same array
for (i = 0; i < k; i++) { last = arr[n - 1];
for (j = n - 1; j > 0; j--) {
arr[j] = arr[j - 1]; // do one right rotation, k times
// shift right
}
arr[0] = last;
}
printf("Rotated array: ");
for (i = 0; i < n; i++) printf("%d ", arr[i]);
printf("\n");
return 0;
}
