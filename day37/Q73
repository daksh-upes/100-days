#include <stdio.h>
int main() {
int a[10][10], rowSum[10], r, c, i, j;
printf("Enter rows and columns: ");
scanf("%d %d", &r, &c);
printf("Enter matrix elements:\n");
for (i = 0; i < r; i++)
for (j = 0; j < c; j++)
scanf("%d", &a[i][j]);
for (i = 0; i < r; i++) {
rowSum[i] = 0; for (j = 0; j < c; j++) {
rowSum[i] = rowSum[i] + a[i][j];
// reset for each row
}
for (i = 0; i < r; i++) {
printf("Sum of row %d = %d\n", i + 1, rowSum[i]);
}
}
return 0;
}
