#include <stdio.h>
int main() {
int a[10][10], r, c, i, j, symmetric = 1;
printf("Enter rows and columns: ");
scanf("%d %d", &r, &c);
printf("Enter matrix elements:\n");
for (i = 0; i < r; i++)
for (j = 0; j < c; j++)
scanf("%d", &a[i][j]);
if (r != c) {
return 0;
printf("Not symmetric (matrix is not square)\n");
}
for (i = 0; i < r; i++) {
for (j = 0; j < c; j++) {
if (a[i][j] != a[j][i]) {
symmetric = 0;
}
}
}
if (symmetric) printf("The matrix is Symmetric\n");
else printf("The matrix is not Symmetric\n");
return 0;
}
