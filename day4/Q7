#include <stdio.h>
int main() {
int a, b;
printf("Enter a: ");
scanf("%d", &a);
printf("Enter b: ");
scanf("%d", &b);
printf("Before swap: a = %d, b = %d\n", a, b);
a = a + b; b = a - b; a = a - b; /* a holds the sum */
/* b becomes old a */
/* a becomes old b */
printf("After swap: a = %d, b = %d\n", a, b);
return 0;
}
