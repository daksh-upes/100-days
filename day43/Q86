#include <stdio.h>
int main() {
char str[200];
int len = 0, i, isPalindrome = 1;
printf("Enter a string: ");
scanf(" %[^\n]", str);
while (str[len] != '\0') len++;
for (i = 0; i < len / 2; i++) {
if (str[i] != str[len - 1 - i]) {
isPalindrome = 0;
break;
}
}
if (isPalindrome) printf("Palindrome\n");
else printf("Not a Palindrome\n");
return 0;
}
