#include <stdio.h>
int main() {
char str[200], ch;
int i, count = 0;
printf("Enter a string: ");
scanf(" %[^\n]", str);
printf("Enter the character to count: ");
scanf(" %c", &ch);
for (i = 0; str[i] != '\0'; i++) {
if (str[i] == ch) {
count++;
}
}
printf("'%c' appears %d time(s)\n", ch, count);
return 0;
}
