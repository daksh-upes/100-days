#include <stdio.h>
int main() {
char str[200];
int i;
printf("Enter a string: ");
scanf(" %[^\n]", str);
for (i = 0; str[i] != '\0'; i++) {
if (str[i] >= 'a' && str[i] <= 'z')
str[i] = str[i] - 32; // lower -> upper
else if (str[i] >= 'A' && str[i] <= 'Z')
str[i] = str[i] + 32; // upper -> lower
}
printf("Toggled: %s\n", str);
return 0;
}
