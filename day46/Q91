#include <stdio.h>
int main() {
char str[200], result[200];
int i, j = 0;
printf("Enter a string: ");
scanf(" %[^\n]", str);
for (i = 0; str[i] != '\0'; i++) {
char ch = str[i];
int isVowel = (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U');
if (!isVowel) {
result[j++] = ch;
}
}
result[j] = '\0'; // end the new string
printf("Without vowels: %s\n", result);
return 0;
}
