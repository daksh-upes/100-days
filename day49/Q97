#include <stdio.h>
int main() {
char name[100];
int i;
printf("Enter full name: ");
scanf(" %[^\n]", name);
for (i = 0; name[i] != '\0'; i++) {
if (name[i] != ' ' && (i == 0 || name[i - 1] == ' ')) { if (name[i] >= 'a' && name[i] <= 'z')
printf("%c.", name[i] - 32); // make uppercase
// first letter of a word
else
printf("%c.", name[i]);
}
}
printf("\n");
return 0;
}
