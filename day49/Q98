#include <stdio.h>
int main() {
char name[100];
int i, len = 0, lastStart = 0;
printf("Enter full name: ");
scanf(" %[^\n]", name);
while (name[len] != '\0') len++;
// find where the last word (surname) starts
for (i = 0; i < len; i++) {
if (name[i] == ' ') {
lastStart = i + 1;
}
}
// initials of all words before the surname
for (i = 0; i < lastStart; i++) {
if (name[i] != ' ' && (i == 0 || name[i - 1] == ' ')) {
printf("%c.", name[i]);
}
}
// full surname
for (i = lastStart; i < len; i++) {
printf("%c", name[i]);
}
printf("\n");
return 0;
}
