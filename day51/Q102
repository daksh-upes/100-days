#include <stdio.h>
int main() {
int arr[100], n, i, x;
int low, high, mid, ans = -1;
scanf("%d", &n);
for (i = 0; i < n; i++) scanf("%d", &arr[i]);
scanf("%d", &x);
low = 0;
high = n - 1;
while (low <= high) {
mid = (low + high) / 2;
if (arr[mid] >= x) {
ans = mid; high = mid - 1;
} else {
low = mid + 1;
// possible answer, try to find a smaller index
}
}
printf("%d\n", ans);
return 0;
}
