#include <stdio.h>
int main() {
int arr[100], n, i;
int total = 0, leftSum = 0, rightSum;
scanf("%d", &n);
for (i = 0; i < n; i++) {
scanf("%d", &arr[i]);
total = total + arr[i];
}
for (i = 0; i < n; i++) {
rightSum = total - leftSum - arr[i];
if (leftSum == rightSum) {
printf("%d\n", i); return 0;
}
leftSum = leftSum + arr[i];
// leftmost pivot found
}
printf("-1\n");
return 0;
}
