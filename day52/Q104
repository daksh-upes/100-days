#include <stdio.h>
int main() {
int n, x;
long long total, leftSum, rightSum;
scanf("%d", &n);
total = (long long)n * (n + 1) / 2; // sum of 1..n
for (x = 1; x <= n; x++) {
leftSum = (long long)x * (x + 1) / 2; rightSum = total - (long long)(x - 1) * x / 2; if (leftSum == rightSum) {
printf("%d\n", x);
return 0;
// 1..x
// x..n
}
}
printf("-1\n");
return 0;
}
