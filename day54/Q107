#include <stdio.h>
int main() {
int n, arr[100];
scanf("%d", &n);
for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
for (int i = 0; i < n; i++) {
int result = -1;
for (int j = i - 1; j >= 0; j--) { if (arr[j] > arr[i]) {
result = arr[j];
break;
// look to the LEFT
}
}
}
if (i > 0) printf(",");
printf("%d", result);
return 0;
}
