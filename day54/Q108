#include <stdio.h>
int main() {
int n, nums[100], answer[100];
scanf("%d", &n);
for (int i = 0; i < n; i++) scanf("%d", &nums[i]);
// Step 1: answer[i] = product of everything to the LEFT of i
int left = 1;
for (int i = 0; i < n; i++) {
answer[i] = left;
left = left * nums[i];
}
// Step 2: multiply with product of everything to the RIGHT of i
int right = 1;
for (int i = n - 1; i >= 0; i--) {
answer[i] = answer[i] * right;
right = right * nums[i];
}
for (int i = 0; i < n; i++) printf("%d ", answer[i]);
return 0;
}
