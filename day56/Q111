#include <stdio.h>
int main() {
int n, k, arr[100];
scanf("%d", &n);
for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
scanf("%d", &k);
for (int i = 0; i <= n - k; i++) {
int answer = 0; // 0 means no negative found
for (int j = i; j < i + k; j++) {
if (arr[j] < 0) {
answer = arr[j];
break; // first negative found
}
}
}
printf("%d ", answer);
return 0;
}
