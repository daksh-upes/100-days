#include <stdio.h>
#include <string.h>
int main() {
char s[1000];
scanf("%s", s);
int len = strlen(s);
int maxLen = 0;
for (int i = 0; i < len; i++) {
int seen[256] = {0}; int count = 0;
for (int j = i; j < len; j++) {
if (seen[(int)s[j]]) break; seen[(int)s[j]] = 1;
count++;
// which characters we've seen
// repeated character, stop
}
if (count > maxLen) maxLen = count;
}
printf("%d", maxLen);
return 0;
}
