#include <stdio.h>
int main() {
int m, n, a[100], b[100], merged[200];
scanf("%d", &m);
for (int i = 0; i < m; i++) scanf("%d", &a[i]);
scanf("%d", &n);
for (int i = 0; i < n; i++) scanf("%d", &b[i]);
int i = 0, j = 0, k = 0;
// pick the smaller element from the two arrays each time
while (i < m && j < n) {
if (a[i] <= b[j]) merged[k++] = a[i++];
else merged[k++] = b[j++];
}
// copy whatever is left
while (i < m) merged[k++] = a[i++];
while (j < n) merged[k++] = b[j++];
for (int x = 0; x < k; x++) printf("%d ", merged[x]);
return 0;
}
