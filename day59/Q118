#include <stdio.h>
int main() {
int n, arr[100];
scanf("%d", &n);
for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
int expectedSum = n * (n + 1) / 2; int actualSum = 0;
for (int i = 0; i < n; i++) actualSum += arr[i];
printf("%d", expectedSum - actualSum); return 0;
// sum of 0..n
// the difference is the missing number
}
