#include <stdio.h>
#include <ctype.h>
int main() {
char s[1000];
fgets(s, sizeof(s), stdin);
int capitalizeNext = 1; for (int i = 0; s[i] != '\0'; i++) {
if (isalpha(s[i])) {
if (capitalizeNext) {
s[i] = toupper(s[i]);
capitalizeNext = 0;
} else {
s[i] = tolower(s[i]);
// first letter should be capital
}
}
// after . ! ? the next letter starts a new sentence
if (s[i] == '.' || s[i] == '!' || s[i] == '?') capitalizeNext = 1;
}
printf("%s", s);
return 0;
}
