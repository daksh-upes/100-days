#include <stdio.h>
int main() {
char name[50];
int age;
printf("Enter name: ");
scanf("%s", name);
printf("Enter age: ");
scanf("%d", &age);
FILE *fp = fopen("info.txt", "w"); if (fp == NULL) {
printf("Error opening file");
return 1;
// "w" = write mode
}
fprintf(fp, "Name: %s\nAge: %d\n", name, age);
fclose(fp);
printf("Data saved successfully");
return 0;
}
