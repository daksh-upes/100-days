#include <stdio.h>
int main() {
char filename[100];
printf("Enter filename: ");
scanf("%s", filename);
FILE *fp = fopen(filename, "r");
if (fp == NULL) {
printf("File not found");
return 1;
}
int chars = 0, words = 0, lines = 0;
int inWord = 0; char ch;
// are we currently inside a word?
while ((ch = fgetc(fp)) != EOF) {
chars++;
if (ch == '\n') lines++;
if (ch == ' ' || ch == '\n' || ch == '\t') {
inWord = 0; } else if (inWord == 0) {
inWord = 1; words++;
// space ends a word
// a new word starts
}
}
if (chars > 0 && lines == 0) lines = 1; // single line without newline
fclose(fp);
printf("Characters: %d\nWords: %d\nLines: %d", chars, words, lines);
return 0;
}
