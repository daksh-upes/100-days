#include <stdio.h>
int main() {
char filename[100], line[200];
printf("Enter filename: ");
scanf("%s", filename);
FILE *fp = fopen(filename, "r");
if (fp == NULL) { printf("Error: file not found");
return 1;
// file does not exist
while (fgets(line, sizeof(line), fp) != NULL) {
printf("%s", line);
}
}
fclose(fp);
return 0;
}
