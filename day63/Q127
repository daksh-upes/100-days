#include <stdio.h>
#include <ctype.h>
int main() {
FILE *in = fopen("input.txt", "r");
FILE *out = fopen("output.txt", "w");
if (in == NULL || out == NULL) {
printf("Error opening file");
return 1;
}
char ch;
while ((ch = fgetc(in)) != EOF) {
fputc(toupper(ch), out); }
fclose(in);
fclose(out);
printf("Done");
return 0;
// toupper changes only lowercase letters
}
