#include <stdio.h>
int main() {
FILE *fp = fopen("numbers.txt", "r");
if (fp == NULL) {
printf("File not found");
return 1;
}
int num, count = 0, sum = 0;
// fscanf returns 1 each time it reads a number successfully
while (fscanf(fp, "%d", &num) == 1) {
sum += num;
count++;
}
fclose(fp);
if (count > 0) {
printf("Sum: %d\n", sum);
printf("Average: %.2f", (float)sum / count);
}
return 0;
}
