#include <stdio.h>
enum Menu { ADD = 1, SUBTRACT, MULTIPLY };
int main() {
int choice, a, b;
printf("1.ADD 2.SUBTRACT 3.MULTIPLY\nEnter choice: ");
scanf("%d", &choice);
printf("Enter two numbers: ");
scanf("%d %d", &a, &b);
switch (choice) {
case ADD: printf("Result: %d", a + b); break;
case SUBTRACT: printf("Result: %d", a - b); break;
case MULTIPLY: printf("Result: %d", a * b); break;
default: printf("Invalid choice");
}
return 0;
}
