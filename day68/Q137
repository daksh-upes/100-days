#include <stdio.h>
enum Role { ADMIN, USER, GUEST };
int main() {
int input;
printf("Enter role (0=ADMIN, 1=USER, 2=GUEST): ");
scanf("%d", &input);
enum Role role = input;
switch (role) {
case ADMIN: printf("Welcome Admin! You have full access."); break;
case USER: printf("Welcome User! You have limited access."); break;
case GUEST: printf("Welcome Guest! You have view-only access."); break;
default: printf("Unknown role");
}
return 0;
}
