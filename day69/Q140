#include <stdio.h>
enum Gender { MALE, FEMALE, OTHER };
struct Person {
char name[50];
enum Gender gender;
};
int main() {
struct Person p;
int g;
printf("Enter name: ");
scanf("%s", p.name);
printf("Enter gender (0=Male, 1=Female, 2=Other): ");
scanf("%d", &g);
p.gender = g;
printf("Name: %s\nGender: ", p.name);
if (p.gender == MALE) printf("Male");
else if (p.gender == FEMALE) printf("Female");
else printf("Other");
return 0;
}
