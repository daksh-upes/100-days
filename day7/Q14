#include <stdio.h>
#include <ctype.h>
int main() {
char ch;
printf("Enter a character: ");
scanf(" %c", &ch);
char c = tolower(ch); /* convert to lowercase */
if (c < 'a' || c > 'z') {
printf("Not an alphabet\n");
} else if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
printf("%c is a Vowel\n", ch);
} else {
printf("%c is a Consonant\n", ch);
}
return 0;
}
