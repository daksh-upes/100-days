#include <stdio.h>
#include <math.h>
int main() {
float a, b, c, D, root1, root2, real, imag;
printf("Enter a: ");
scanf("%f", &a);
printf("Enter b: ");
scanf("%f", &b);
printf("Enter c: ");
scanf("%f", &c);
if (a == 0) {
return 0;
printf("Not a quadratic equation (a cannot be 0)\n");
}
D = b * b - 4 * a * c;
if (D > 0) {
root1 = (-b + sqrt(D)) / (2 * a);
  root2 = (-b - sqrt(D)) / (2 * a);
printf("Real and Different roots\n");
printf("Root 1 = %.2f\n", root1);
printf("Root 2 = %.2f\n", root2);
} else if (D == 0) {
root1 = -b / (2 * a);
printf("Real and Equal roots\n");
printf("Root 1 = Root 2 = %.2f\n", root1);
} else {
real = -b / (2 * a);
imag = sqrt(-D) / (2 * fabs(a));
printf("Complex (Imaginary) roots\n");
printf("Root 1 = %.2f + %.2fi\n", real, imag);
printf("Root 2 = %.2f - %.2fi\n", real, imag);
}
return 0;
}
